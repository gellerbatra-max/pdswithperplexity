{
  "name": "@pds/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check:offset": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/register.mjs scripts/check-offset.ts",
    "check:curve": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/register.mjs scripts/check-curve.ts",
    "check": "npm run check:curve && npm run check:offset && npm run check:roundtrip && npm run check:grading && npm run check:dxf",
    "check:roundtrip": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/register.mjs scripts/check-roundtrip.ts",
    "check:grading": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/register.mjs scripts/check-grading.ts",
    "check:dxf": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/register.mjs scripts/check-dxf-import.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
